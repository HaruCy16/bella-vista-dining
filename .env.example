# Copy to .env (never commit .env). Every value has a default in
# docker-compose.yml, so .env is only needed to override something.

APP_ENV=development
APP_PORT=8080
PMA_PORT=8081
DB_HOST_PORT=3306

# Used by the app container and to create the MySQL user on first start.
# DB_HOST/DB_PORT are fixed to the "db" service inside Docker; set them only
# when running against another server (e.g. shared hosting).
DB_NAME=bella_vista
DB_USER=bella
DB_PASSWORD=bella_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# Public site URL used in payment return links (optional; detected from the request otherwise).
APP_URL=

# Google Maps Embed API key (optional). Without it the map uses Google's keyless embed.
# Create one at console.cloud.google.com, enable "Maps Embed API", restrict it to your domain.
GOOGLE_MAPS_EMBED_API_KEY=

# Payments: "mock" (sandbox page, default). PayMongo test keys go here later.
PAYMENT_PROVIDER=mock
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
